app("Multi-page ViBao demo") {
    @the Card(title: chuoi, subtitle: chuoi) {
        box {
            @spacing { padding: 16, border: 1, radius: 8 }
            @color { border_color: xam_nhat }

            text($title, font_size: 18, bold: true)
            text($subtitle, font_size: 14, color: xam)
        }
    }

    page("/") {
        flex {
            @flex_layout { direction: column, gap: 16 }
            @spacing { padding: 24 }

            text("Home", font_size: 28, bold: true)
            Card(title: "Fast to write", subtitle: "Vietnamese or English syntax")
            Card(title: "Small runtime", subtitle: "WebAssembly, no framework")
            link("About", to: "/about")
        }
    }

    page("/about") {
        flex {
            @flex_layout { direction: column, gap: 12 }
            @spacing { padding: 24 }

            text("About", font_size: 28, bold: true)
            text("This app was compiled with vibaoc.")
            link("Back home", to: "/")
        }
    }
}
