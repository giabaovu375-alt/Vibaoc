// 17 — Actions: navigate, scroll_to_top, save_data, load_data, api_call.
// English surface. Also documents a REAL LIMITATION found while reading
// the source: open_modal/close_modal expect an element whose HTML id is
// exactly "vb-modal-<id>", but there is NO prop in the language to set a
// custom `id` on any element (checked prop_vi.rs/prop_en.rs - no `id`/
// `ma` PropKey exists at all) - the ONLY element that ever gets that id
// shape is the `modal` tag itself, and `modal` currently renders as an
// EMPTY placeholder (see docs section 9 / element.rs::BUILTIN_COMPLEX).
// So open_modal/close_modal have no working target in 0.1.0. Left
// commented out below instead of asserting a false positive.
app("Actions demo EN") {
    page("/") {
        state $note = "Hello"

        button("Go to about") {
            on_click { navigate("/about") }
        }
        button("Scroll to top") {
            on_click { scroll_to_top() }
        }
        button("Save note") {
            on_click { save_data("/api/notes", {text: $note}) }
        }
        button("Load notes") {
            on_click { load_data("/api/notes") }
        }
        button("Call API directly") {
            on_click { api_call("GET", "/api/ping") }
        }
        button("Call API with callbacks") {
            on_click {
                // English response handlers `success`/`failure` and the
                // English toast option `type:` are normalized by the
                // parser to `thanh_cong`/`that_bai` and `kieu:`.
                api_call("GET", "/api/ping") {
                    success {
                        notify("API OK", type: success)
                    }
                    failure {
                        notify("API failed", type: error)
                    }
                }
            }
        }

        // open_modal/close_modal intentionally NOT exercised here - see
        // the note above; there is no valid element id target in 0.1.0.
    }

    page("/about") {
        text("About page (scroll target)")
    }
}
